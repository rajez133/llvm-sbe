diff --git a/lib/Target/PowerPC/PPCInstrInfo.cpp b/lib/Target/PowerPC/PPCInstrInfo.cpp
index 7c1550e..ae48090 100644
--- a/lib/Target/PowerPC/PPCInstrInfo.cpp
+++ b/lib/Target/PowerPC/PPCInstrInfo.cpp
@@ -3129,6 +3129,47 @@ bool PPCInstrInfo::expandPostRAPseudo(MachineInstr &MI) const {
     MI.removeOperand(0);
     return true;
   }
+  case PPC::LI8_VDR: {
+    // Expand LI8_VDR pseudo to load 64-bit immediate into VDR register pair
+    // LI8_VDR rD, imm64 -> LI rD_lo, imm_lo
+    //                       LIS rD_hi, imm_hi
+    Register DestReg = MI.getOperand(0).getReg();
+    int64_t Imm = MI.getOperand(1).getImm();
+
+    // Get the two GPRs that make up the VDR register pair using subregister API
+    const TargetRegisterInfo *TRI = &getRegisterInfo();
+    Register HiReg = TRI->getSubReg(DestReg, PPC::sub_gpr_hi);  // High word (even register)
+    Register LoReg = TRI->getSubReg(DestReg, PPC::sub_gpr_lo);  // Low word (odd register)
+
+    // Split the 64-bit immediate into high and low 32-bit parts
+    uint32_t ImmLo = static_cast<uint32_t>(Imm & 0xFFFFFFFF);
+    uint32_t ImmHi = static_cast<uint32_t>((Imm >> 32) & 0xFFFFFFFF);
+
+    // Load low word: LI rD_lo, imm_lo (sign-extended 16-bit)
+    int16_t ImmLo16 = static_cast<int16_t>(ImmLo & 0xFFFF);
+    BuildMI(MBB, MI, DL, get(PPC::LI), LoReg).addImm(ImmLo16);
+
+    // Load high word: LIS rD_hi, imm_hi (upper 16 bits)
+    int16_t ImmHi16 = static_cast<int16_t>((ImmHi >> 16) & 0xFFFF);
+    BuildMI(MBB, MI, DL, get(PPC::LIS), HiReg).addImm(ImmHi16);
+
+    // If lower 16 bits of high word are non-zero, add ORI
+    if ((ImmHi & 0xFFFF) != 0) {
+      BuildMI(MBB, MI, DL, get(PPC::ORI), HiReg)
+          .addReg(HiReg)
+          .addImm(ImmHi & 0xFFFF);
+    }
+
+    // If upper 16 bits of low word are non-zero, add ORIS
+    if ((ImmLo >> 16) != 0) {
+      BuildMI(MBB, MI, DL, get(PPC::ORIS), LoReg)
+          .addReg(LoReg)
+          .addImm((ImmLo >> 16) & 0xFFFF);
+    }
+
+    MI.eraseFromParent();
+    return true;
+  }
