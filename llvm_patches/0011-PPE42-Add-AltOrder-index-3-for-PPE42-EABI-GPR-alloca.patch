From 91350e37395e8416b2ed8c36fa168f1b7fc35283 Mon Sep 17 00:00:00 2001
From: Rajees P P <rajerpp1@in.ibm.com>
Date: Sun, 23 Aug 2026 22:33:11 +0530
Subject: [PATCH 11/12] PPE42: Add AltOrder index 3 for PPE42 EABI GPR
 allocation

Add a new AltOrder (index 3) to GPRC and GPRC_NOR0 that restricts
register allocation to the 16 hardware GPRs present on PPE42:
  volatile:      R3-R10
  callee-saved:  R31-R28
  scratch/last:  R0 (R1, R2, R13 reserved by EABI)

R11, R12 and R14-R27 do not exist on PPE42 hardware and are blocked
via getReservedRegs() in PPCRegisterInfo.cpp (separate commit).
R2 (SDA2) and R13 (SDA) are EABI-reserved and placed last in the
order so the allocator exhausts all allocatable registers first.

getGPRAllocationOrderIdx() returns 3 when isPPE42() is true.
The comment block above the function is updated to document all
four index values.
---
 lib/Target/PowerPC/PPCRegisterInfo.td | 19 +++++++++++++++++--
 lib/Target/PowerPC/PPCSubtarget.h     |  6 ++++++
 2 files changed, 23 insertions(+), 2 deletions(-)

diff --git a/lib/Target/PowerPC/PPCRegisterInfo.td b/lib/Target/PowerPC/PPCRegisterInfo.td
index f55a43a..7b6636b 100644
--- a/lib/Target/PowerPC/PPCRegisterInfo.td
+++ b/lib/Target/PowerPC/PPCRegisterInfo.td
@@ -363,9 +363,18 @@ def GPRC : RegisterClass<"PPC", [i32,f32], 32, (add (sequence "R%u", 2, 12),
   // On AIX, CSRs are allocated starting from R31 according to:
   // https://www.ibm.com/docs/en/ssw_aix_72/assembler/assembler_pdf.pdf.
   // This also helps setting the correct `NumOfGPRsSaved' in traceback table.
+  //
+  // AltOrder index 2: PPE42 EABI.
+  // Allocatable GPRs: R3-R10 (volatile), R28-R31 (callee-saved), R0 (scratch).
+  // R1 (SP), R2 (SDA2), R13 (SDA) are reserved and listed last so they are
+  // only used as a last resort by the allocator (getReservedRegs also blocks
+  // R2 and R13 from being assigned).
   let AltOrders = [(add (sub GPRC, R2), R2),
                    (add (sequence "R%u", 2, 12),
-                        (sequence "R%u", 31, 13), R0, R1, FP, BP)];
+                        (sequence "R%u", 31, 13), R0, R1, FP, BP),
+                   (add (sequence "R%u", 3, 10),
+                        (sequence "R%u", 31, 28),
+                        R0, R1, R2, R13)];
   let AltOrderSelect = [{
     return MF.getSubtarget<PPCSubtarget>().getGPRAllocationOrderIdx();
   }];
@@ -390,9 +399,15 @@ def G8RC : RegisterClass<"PPC", [i64], 64, (add (sequence "X%u", 2, 12),
 def GPRC_NOR0 : RegisterClass<"PPC", [i32,f32], 32, (add (sub GPRC, R0), ZERO)> {
   // On non-Darwin PPC64 systems, R2 can be allocated, but must be restored, so
   // put it at the end of the list.
+  //
+  // AltOrder index 2: PPE42 EABI — same set as GPRC but without R0.
+  // R0 is excluded here as it has special meaning in instructions using NOR0.
   let AltOrders = [(add (sub GPRC_NOR0, R2), R2),
                    (add (sequence "R%u", 2, 12),
-                        (sequence "R%u", 31, 13), R1, FP, BP, ZERO)];
+                        (sequence "R%u", 31, 13), R1, FP, BP, ZERO),
+                   (add (sequence "R%u", 3, 10),
+                        (sequence "R%u", 31, 28),
+                        R1, R2, R13, ZERO)];
   let AltOrderSelect = [{
     return MF.getSubtarget<PPCSubtarget>().getGPRAllocationOrderIdx();
   }];
diff --git a/lib/Target/PowerPC/PPCSubtarget.h b/lib/Target/PowerPC/PPCSubtarget.h
index 9a97d1a..62b4429 100644
--- a/lib/Target/PowerPC/PPCSubtarget.h
+++ b/lib/Target/PowerPC/PPCSubtarget.h
@@ -305,7 +305,13 @@ public:
 
   // Select allocation orders of GPRC and G8RC. It should be strictly consistent
   // with corresponding AltOrders in PPCRegisterInfo.td.
+  // Index 0: default (R2-R12, R30-R13, R31, R0, R1)
+  // Index 1: 64-bit ELF ABI (R2 moved to end)
+  // Index 2: AIX ABI
+  // Index 3: PPE42 EABI (R3-R10, R31-R28, R0; R2/R13 reserved by EABI)
   unsigned getGPRAllocationOrderIdx() const {
+    if (isPPE42())
+      return 3;
     if (is64BitELFABI())
       return 1;
     if (isAIXABI())
-- 
