#!/usr/bin/env bash
set -e

CONTAINER_NAME="llvm-dev"
LLVM_SRC_DIR="`pwd`/llvm"
CPP_SRC_DIR="`pwd`/appsource"
LLVM_BUILD_DIR="${LLVM_SRC_DIR}/build"
VOLUME_NAME="llvm-build-cache"


# --- CHECK LLVM SOURCE ---
#if [ ! -d "${LLVM_SRC_DIR}/llvm" ]; then
#    echo "LLVM source not found, cloning..."
    #git clone --depth 1 https://github.com/llvm/llvm-project.git "${LLVM_SRC_DIR}/llvm"
#else
#    echo "LLVM source already exists, skipping clone."
#fi

IMAGE_NAME="llvm-dev:latest"
DOCKERFILE_PATH="Dockerfile"

# --- CHECK & BUILD DOCKER IMAGE ---
if ! docker image inspect "${IMAGE_NAME}" >/dev/null 2>&1; then
    echo "Docker image ${IMAGE_NAME} not found. Building it now..."
    if [ ! -f "${DOCKERFILE_PATH}" ]; then
        echo "Error: Dockerfile not found at ${DOCKERFILE_PATH}."
        exit 1
    fi
    docker build -t "${IMAGE_NAME}" -f "${DOCKERFILE_PATH}" "$(dirname "${DOCKERFILE_PATH}")"
else
    echo "Docker image ${IMAGE_NAME} already exists. Skipping build."
fi

LLVM_TAR="${LLVM_SRC_DIR}/llvm-project.tar.xz"
LLVM_URL="https://github.com/llvm/llvm-project/releases/download/llvmorg-21.1.4/llvm-project-21.1.4.src.tar.xz"

if [ ! -d "${LLVM_SRC_DIR}/llvm" ]; then
    echo "LLVM source not found."

    mkdir -p "${LLVM_SRC_DIR}"

    if [ ! -f "${LLVM_TAR}" ]; then
        echo "Downloading LLVM tarball..."
        wget -O "${LLVM_TAR}" "${LLVM_URL}"
    else
        echo "LLVM tarball already exists, skipping download."
    fi

    echo "Extracting LLVM..."
    tar -xf "${LLVM_TAR}" -C "${LLVM_SRC_DIR}"
    mv "${LLVM_SRC_DIR}"/llvm-project-* "${LLVM_SRC_DIR}/llvm"

    # Initialize git repo and apply PPE42 patch
    cd "${LLVM_SRC_DIR}/llvm"

    if [ ! -d ".git" ]; then
        echo "Initializing git repository in LLVM source..."
        git init

        # Set a local identity so git commit works in CI environments
        # where no global git config is present (e.g. GitHub Actions runners).
        git config user.email "llvm-build@localhost"
        git config user.name "LLVM Build"

        # Add only PowerPC backend files (matching first commit)
        echo "Adding PowerPC backend files to git..."
        git add lib/Target/PowerPC/
        git add include/llvm/TargetParser/PPCTargetParser.def
        git commit -m "Adding original PowerPC target description files"

        # Apply PPE42 backend patch
        PATCH_FILE="$(dirname "${LLVM_SRC_DIR}")/llvm_patches/0001-Adding-ppe-lvd-stvd-instruction-support-in-assembly-.patch"
        if [ -f "${PATCH_FILE}" ]; then
            echo "Applying PPE42 backend patch..."
            git am "${PATCH_FILE}"
            echo "PPE42 patch applied successfully."
        else
            echo "Warning: PPE42 patch file not found at ${PATCH_FILE}"
            echo "Continuing without patch..."
        fi
    else
        echo "Git repository already initialized, skipping git setup."
    fi

    cd -
else
    echo "LLVM source already exists, skipping download and extraction."
fi

# --- CREATE BUILD DIRECTORY IF MISSING ---
mkdir -p "${LLVM_BUILD_DIR}"

# Detect TTY availability
if [ -t 1 ]; then
  DOCKER_TTY_ARGS="-it"
else
  DOCKER_TTY_ARGS="--rm"
fi

# --- CREATE DOCKER VOLUME FOR BUILD CACHE ---
if ! docker volume inspect "${VOLUME_NAME}" >/dev/null 2>&1; then
    echo "Creating Docker volume ${VOLUME_NAME} for build cache..."
    docker volume create "${VOLUME_NAME}"
else
    echo "Docker volume ${VOLUME_NAME} already exists."
fi

# --- RUN THE CONTAINER ---
echo "Starting LLVM development container..."

docker run ${DOCKER_TTY_ARGS} \
    --rm \
    --name "${CONTAINER_NAME}" \
    -v "${LLVM_SRC_DIR}:/root/llvm-project" \
    -v "${CPP_SRC_DIR}:/workspace" \
    -v "${VOLUME_NAME}:/build" \
    -w /root/llvm-project \
    $IMAGE_NAME \
    bash -c "
        set -e;

        # Use persistent build directory from Docker volume
        mkdir -p /build/llvm-build
        cd /build/llvm-build

        if [ ! -f build.ninja ]; then
            echo 'Configuring LLVM with CMake...';
            cmake -G Ninja /root/llvm-project/llvm/llvm \
                -DLLVM_ENABLE_PROJECTS='clang;lld' \
                -DCMAKE_BUILD_TYPE=Release \
                -DLLVM_TARGETS_TO_BUILD='PowerPC' \
                -DCMAKE_INSTALL_PREFIX=/opt/llvm-install
        else
            echo 'CMake already configured, skipping...';
        fi

        echo 'Building LLVM...';
	ninja;

        if [ ! -f /opt/llvm-install/bin/clang ]; then
            echo 'Installing LLVM...';
            ninja install;
        fi

        echo 'LLVM build complete. Launching shell.';
        export PATH=/opt/llvm-install/bin:\$PATH
 cd  /workspace

 # Run the assembly test script first
 echo '=== Running Assembly Test (simple_test_assembly/test_asm.sh) ==='
 cd simple_test_assembly && ./test_asm.sh && cd ..

 # Run the build phases script
 # echo ''
 # echo '=== Running Build Phases (build_phases.sh) ==='
 # ./build_phases.sh

 exec bash
    "
