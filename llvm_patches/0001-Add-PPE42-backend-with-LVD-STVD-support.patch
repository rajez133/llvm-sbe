+  else if (Name.starts_with("d")) {
+    // VDR registers for PPE42 (d0, d2-d9, d28-d30)
+    // These are already matched by MatchRegisterName, just extract the number
+    // IntVal already contains the register number from line 1331
+  }
 
   getParser().Lex();
   return RegNo;
